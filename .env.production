# Database Configuration (Supabase)
DATABASE_URL=postgresql://username:password@host:5432/database?pgbouncer=true&connection_limit=1

# Server Configuration
PORT=3000
NODE_ENV=production
CLIENT_SIDE_URL=https://rentease.com

# Redis Configuration (AWS ElastiCache)
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=rentease-redis-cluster.xxxxx.cache.amazonaws.com
REDIS_PORT=6379

# JWT Secrets (Generate strong secrets)
JWT_ACCESS_TOKEN_SECRET=your_super_secure_access_token_secret_here
JWT_REFRESH_TOKEN_SECRET=your_super_secure_refresh_token_secret_here
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Email Configuration
NODEMAILER_EMAIL=your_email@domain.com
NODEMAILER_PASS=your_app_password

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
FIREBASE_IMAGE_API_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-image-api.json

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY=your_access_key
AWS_SECRET_KEY=your_secret_key
AWS_BUCKET_NAME=rentease-documents
S3_EXPIRY_TIME=3600

# Logging Configuration
LOG_FILE_PATH=/app/logs/app.log
LOG_FILE_SIZE=10MB
LOG_FILE_COUNT=5
LOG_LEVEL=info

# Map Configuration
OLA_MAP_TOKEN_API=your_ola_map_token
OLA_MAP_CLIENT_ID=your_client_id
OLA_MAP_CLIENT_SECRET=your_client_secret

# Stripe Configuration (PRODUCTION KEYS)
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=USD

# Video Conference Configuration
VITE_PUBLIC_JAAS_APP_ID=your_jaas_app_id
VIDEO_PRIVATE_KEY=your_video_private_key